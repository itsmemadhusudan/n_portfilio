APP_NAME="Madhusudan Timalsina"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The portfolio reads all content from config/portfolio.php and touches no tables,
# so file drivers keep the deploy database-free.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
# Mailjet API key + secret (set on the server — never commit real values)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="timmadh@gmail.com"
MAIL_FROM_NAME="Madhusudan Timalsina"
MAIL_TO_ADDRESS="timmadh@gmail.com"

# Needs a PHP host. Set false for static GitHub Pages exports.
CONTACT_FORM_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
